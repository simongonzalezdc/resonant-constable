{
  "id": "addon.constable",
  "name": "Constable — Injection Defense Kit",
  "version": "0.1.0",
  "author": "KyaniteLabs",
  "category": "security",
  "sdkVersion": "0.1.0",
  "description": "The defense half of the discipline behind the merged quote-aware argv fix, packaged for the add-on authors the SDK moment creates: a doctrine doc (four stored-content patterns and their data-boundary alternatives), a known-answer corpus of public attack classes on synthetic fixtures with typed negatives, and a stdlib-only detect-and-explain checker exposed as a CLI and a loopback local service. It claims nothing about the security of any deployed system; all corpus entries are public attack classes on synthetic fixtures; this is not a security audit. Reads are operator-scoped (only paths the operator passes), the service binds 127.0.0.1:4902 only, and the only bytes written are its own var/ reports.",
  "runtimeType": "local-service",
  "surfaces": [],
  "requestedCapabilities": [
    {
      "capability": "filesystem",
      "granted": false,
      "scope": "workspace",
      "revocationBehavior": "hard-stop"
    }
  ],
  "provenance": {
    "tier": "sideloaded-unverified",
    "verificationState": "unverified",
    "signed": false
  },
  "runtimeIsolation": {
    "boundary": "host-mediated-service",
    "supportsDegradedMode": true,
    "requiresReviewedGrant": true
  },
  "grantPresets": [
    {
      "id": "constable-scan",
      "label": "Scan operator-chosen trees",
      "description": "Allow Constable to read the files and directories the operator passes to constable.scan (default 1..16 paths per call). Read-only: nothing under the scanned roots is modified, scanned contents are never echoed whole (findings quote minimal spans), and the only bytes written are this add-on's own var/ reports.",
      "grants": [
        {
          "capability": "filesystem",
          "granted": true,
          "scope": "workspace",
          "revocationBehavior": "hard-stop"
        }
      ]
    }
  ],
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": true
  },
  "systemSlots": [],
  "archiveIntegration": {
    "readScopes": [],
    "intakeWriteScopes": [],
    "canRequestIngest": false,
    "canWriteKnowledgePages": false
  },
  "health": {
    "strategy": "http-json-status"
  },
  "service": {
    "protocol": "http-json",
    "entrypoint": "http://127.0.0.1:4902",
    "healthCommand": "constable.status"
  },
  "tools": [
    {
      "name": "constable.status",
      "description": "Report service health: ok flag, addon id, engine version, the receipt banner, the rule list with doctrine patterns, and the honesty note on what known-answer does and does not prove. Takes no parameters.",
      "requiredCapabilities": ["filesystem"],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "addon": { "type": "string", "const": "addon.constable" },
          "tool": { "type": "string" },
          "engine_version": { "type": "string" },
          "banner": { "type": "string", "description": "The receipt banner, verbatim" },
          "rules": { "type": "array", "items": { "type": "string" } },
          "doctrine_patterns": { "type": "array", "items": { "type": "string" } },
          "mode": { "type": "string" },
          "capabilities_requested": { "type": "array", "items": { "type": "string" } },
          "network": { "type": "string" },
          "honesty_note": { "type": "string" }
        },
        "required": ["ok", "addon", "engine_version", "banner"]
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "constable.scan",
      "description": "Scan 1..16 operator-given absolute paths (files or directories) with the stdlib-only injection-defense checker. Detect-and-explain: findings name the rule, the doctrine pattern, a minimal-span excerpt, and the data-boundary fix; the default never fails a build. Paths are read-only; scanned contents are never echoed whole; home paths are redacted in the response.",
      "requiredCapabilities": ["filesystem"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": { "type": "string", "maxLength": 1024 },
            "minItems": 1,
            "maxItems": 16,
            "description": "Absolute paths to files or directories the operator chose to scan"
          }
        },
        "required": ["paths"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tool": { "type": "string" },
          "schema": { "type": "string", "const": "constable-report/1" },
          "banner": { "type": "string" },
          "engine_version": { "type": "string" },
          "mode": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } },
          "files_scanned": { "type": "integer" },
          "findings_count": { "type": "integer" },
          "rules_fired": { "type": "array", "items": { "type": "string" } },
          "findings": { "type": "array", "items": { "type": "object" } },
          "corpus_hash": { "type": "string" }
        },
        "required": ["schema", "banner", "engine_version", "files_scanned", "findings_count", "findings"]
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["diagnostic-report", "log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "constable.corpus",
      "description": "Summarize the pinned known-answer corpus: class ids with public citations, entry counts by label, the corpus sha256, and the full entry index (fixture ids, classes, labels, rule bindings). Fixture contents are not served.",
      "requiredCapabilities": ["filesystem"],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tool": { "type": "string" },
          "banner": { "type": "string" },
          "classes": { "type": "integer" },
          "entries": { "type": "integer" },
          "attacks": { "type": "integer" },
          "typed_negatives": { "type": "integer" },
          "defense_exemplars": { "type": "integer" },
          "corpus_hash": { "type": "string" },
          "class_ids": { "type": "array", "items": { "type": "string" } },
          "index": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["tool", "banner", "classes", "entries", "corpus_hash", "index"]
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "constable.known_answer",
      "description": "Run the pinned corpus against its labels and return the receipt: all_pass, per-label counts, and per-fixture results. This is a known-answer rehearsal — corpus and checker are co-developed, so it proves the checker executes its own labels, not efficacy against the world.",
      "requiredCapabilities": ["filesystem"],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tool": { "type": "string" },
          "schema": { "type": "string" },
          "banner": { "type": "string" },
          "note": { "type": "string" },
          "engine_version": { "type": "string" },
          "corpus_hash": { "type": "string" },
          "all_pass": { "type": "boolean" },
          "attacks_detected": { "type": "integer" },
          "attacks_total": { "type": "integer" },
          "negatives_clean": { "type": "integer" },
          "negatives_total": { "type": "integer" },
          "defenses_clean": { "type": "integer" },
          "defenses_total": { "type": "integer" },
          "results": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["tool", "schema", "banner", "corpus_hash", "all_pass", "results"]
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["diagnostic-report", "log"] },
      "requiresHumanApproval": false
    }
  ],
  "installHooks": {
    "onInstall": "start-constable-service"
  },
  "compatibility": {
    "shellVersion": "^0.1.0",
    "platforms": ["macOS", "linux", "windows"]
  }
}
