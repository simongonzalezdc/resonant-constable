{
  "schema": "constable-corpus/1",
  "name": "constable known-answer corpus",
  "banner": "This kit teaches a defense discipline and ships a reference checker. It claims nothing about the security of any deployed ResonantOS system. All corpus entries are public attack classes demonstrated on synthetic fixtures. This is not a security audit.",
  "typed_negative_applicability": "Every defense pattern (engine rule) carries at least one typed negative. Attack-class entries carry typed negatives wherever a benign lookalike exists; in this corpus every class has at least one lookalike, so every class carries at least one typed negative. The integrity test enforces: label pass implies typed_negative_for; every rule id has at least one negative; every class id has at least one negative.",
  "label_vocabulary": {
    "detect": "the checker must flag this fixture, at least via caught_by",
    "pass": "benign typed negative; the checker must stay silent",
    "reject": "data-boundary defense exemplar; the boundary refuses and the checker must stay silent"
  },
  "classes": [
    {
      "id": "C1-SHELL-INTERP",
      "name": "shell-string interpolation of stored fields",
      "citation": "CWE-78: OS Command Injection — https://cwe.mitre.org/data/definitions/78.html",
      "doctrine_pattern": "P2-shell-string",
      "rule_id": "R1-SHELL-STRING-EXEC",
      "provenance": "textbook family; merged-fix worked example: PR 333 (commit 72c649f), quote-aware argv execution, no shell"
    },
    {
      "id": "C2-EVAL-STORED",
      "name": "stored text handed to a dynamic evaluator",
      "citation": "CWE-95: Eval Injection — https://cwe.mitre.org/data/definitions/95.html",
      "doctrine_pattern": "P2-shell-string",
      "rule_id": "R2-EVAL-FAMILY",
      "provenance": "textbook family; origin example: bin/authority (augmentatism-stack, 2026-08-30) executed stored --source values via awk system() on every later query"
    },
    {
      "id": "C3-LOOSE-PARSE",
      "name": "stored content parsed by a first-match or loose grammar",
      "citation": "CWE-20: Improper Input Validation — https://cwe.mitre.org/data/definitions/20.html",
      "doctrine_pattern": "P3-loose-grammar",
      "rule_id": "R3-LOOSE-KEY-PARSE",
      "provenance": "textbook family; origin example: bin/cure (augmentatism-stack, 2026-08-30) where a newline-forged cutoff field won a first-match parse"
    },
    {
      "id": "C4-REGEX-INTERP",
      "name": "stored keys interpolated into regex or query grammars",
      "citation": "CWE-185: Incorrect Regular Expression — https://cwe.mitre.org/data/definitions/185.html",
      "doctrine_pattern": "P4-regex-interpolation",
      "rule_id": "R4-REGEX-INTERPOLATION",
      "provenance": "textbook family"
    },
    {
      "id": "C5-PROMPT-STORED",
      "name": "stored content concatenated into instruction-bearing text",
      "citation": "OWASP Top 10 for LLM Applications, LLM01: Prompt Injection — https://owasp.org/www-project-top-10-for-large-language-model-applications/",
      "doctrine_pattern": "P1-message-boundary",
      "rule_id": "R5-INSTRUCTION-CONCAT",
      "provenance": "public LLM-application family"
    },
    {
      "id": "C6-REDOS-BACKTRACKING",
      "name": "catastrophic backtracking in a detection or validation pattern",
      "citation": "CWE-1333: Inefficient Regular Expression Complexity — https://cwe.mitre.org/data/definitions/1333.html",
      "doctrine_pattern": "P4-regex-interpolation",
      "rule_id": "R6-CATASTROPHIC-QUANTIFIER",
      "provenance": "textbook family; the reason contributed checker patterns are literal-regex-only (contribution gates, README)"
    }
  ],
